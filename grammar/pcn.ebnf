
file      = { line } ;
line      = tag | end | score | setup | shot | board | comment | empty ;
tag       = "[" key WS string "]" ;
end       = "End" WS int { WS kv } ;
score     = "Score" WS ( "X" | num "-" num ) ;          (* num は int または "X" *)
setup     = "Setup" ;
shot      = int [ WS side ] WS shotspec { WS ( kv | "est" ) } ;
board     = "@" { WS stone } ;
stone     = side coord "," coord [ "*" ] ;              (* 末尾 * = 場内に残った投球石 *)
side      = "R" | "Y" ;
shotspec  = task [ handle ] [ points ] { nag } | "-" | "X" ;
task      = "D"|"F"|"G"|"R"|"W"|"Z"|"T"|"H"|"C"|"S"|"P"|"?" ;   (* "?" = 種別未指定 *)
handle    = ">" | "<" ;
points    = "0"|"1"|"2"|"3"|"4" ;
nag       = "!" | "?" ;
kv        = key "=" value ;                                (* value に空白は含まない *)
comment   = ";" { any } ;

(* タグの値の中の書き方 *)
rules     = kv { WS kv } ;                                 (* [Rules "…"]。key は英小文字。§6.2 *)
shootout  = sotry { ";" WS sotry } ;                       (* [Shootout "…"]。投げた順 *)
sotry     = side WS number [ WS "(" name ")" ] ;          (* 距離 cm。0 = ピンを覆う、199.6 = ハウスの外 *)

行末の `; コメント` はどの行にも付けられます。大文字小文字は区別します。
